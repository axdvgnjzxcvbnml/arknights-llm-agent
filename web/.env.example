# 复制成 .env.local 后按需修改（.env.local 不入库）

# true（默认）= 用 web/src/mock 下的静态数据；false = 请求真实后端
VITE_USE_MOCK=true

# 后端 FastAPI 基地址。留空 = 同源，由 vite.config.js 的 /api 代理转发到 http://127.0.0.1:8000
VITE_API_BASE=

# mock 模式下模拟的网络延迟（毫秒），用来验证 loading 态；0 = 关闭
VITE_MOCK_LATENCY_MS=120

# 接口请求超时（毫秒）
VITE_REQUEST_TIMEOUT_MS=15000
